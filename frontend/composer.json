{
  "name": "jarvis/laravel-dashboard",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0"
  },
  "require-dev": {
    "laravel/pint": "^1.13"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"],
    "dev": ["@php artisan serve --host=127.0.0.1 --port=9999"]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
